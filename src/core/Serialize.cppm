module;

#include <bit>
#include <cstddef>
#include <cstdint>
#include <span>
#include <string>
#include <string_view>
#include <type_traits>
#include <utility>
#include <vector>
#include <version>

#if defined(__cpp_impl_reflection) && defined(__cpp_lib_reflection)
#include <meta>
#define STEREON_SERIALIZE_REFLECTION 1
#else
#define STEREON_SERIALIZE_REFLECTION 0
#endif

export module Stereon.Core:Serialize;

import :Error;
import :SmallBuffer;

/// A serialiser generated by static reflection (ADR-0012, ADR-0016): the
/// groundwork for the .stn chunks and for stn-dump. No struct has
/// hand-written serialisation code; the members are walked in declaration
/// order with std::meta::nonstatic_data_members_of, recursively, down to
/// arithmetic values and enumerations.
///
/// - Serialized(value): the binary form, every value little-endian, doubles
///   as their IEEE 754 bit pattern, bools as one byte. A new member changes
///   the layout; the .stn format will version it (ADR-0012).
/// - Deserialized<T>(bytes): the inverse. Truncated or overlong input and a
///   bool byte other than 0 or 1 are a ParseError, never a contract
///   violation, because file contents are data (ADR-0006).
/// - ToJson(value): a JSON view with member names, for debugging and diffs.
///   Non-finite doubles become the strings "nan", "inf" and "-inf".
///
/// Compilers without reflection (Clang and MSVC so far) get the same
/// functions reporting NotSupported, so code using them still builds there.

export namespace Stereon {

/// True when the serialiser works in this build.
inline constexpr bool SerializationAvailable = STEREON_SERIALIZE_REFLECTION != 0;

} // namespace Stereon

namespace Stereon::Detail {

// Messages and number formatting, defined in Serialize.cpp: std::format in
// inline code of a module interface makes GCC 16.2 emit duplicate
// definitions of libstdc++'s formatting internals
// (docs/toolchain/gcc16-feature-probe.md).
[[nodiscard]] std::string TruncatedInputMessage(std::size_t needed, std::size_t offset,
                                                std::size_t available);
[[nodiscard]] std::string InvalidBoolMessage(std::uint64_t value, std::size_t offset);
[[nodiscard]] std::string LeftoverBytesMessage(std::size_t count);
void AppendJsonDouble(double x, std::string& out);
void AppendJsonInteger(long long x, std::string& out);
void AppendJsonUnsigned(unsigned long long x, std::string& out);

} // namespace Stereon::Detail

#if STEREON_SERIALIZE_REFLECTION
namespace Stereon::Detail {

template <typename T>
inline constexpr bool IsLeaf = std::is_arithmetic_v<T> || std::is_enum_v<T>;

/// The non-static data members of T, private ones included: the serialiser
/// stores a value's whole state, as the .stn tables will.
template <typename T>
consteval auto MembersOf()
{
    return std::define_static_array(
        std::meta::nonstatic_data_members_of(^^T, std::meta::access_context::unchecked()));
}

/// The leaf as an unsigned integer of its size, to write byte by byte.
template <typename T>
[[nodiscard]] constexpr auto BitsOf(const T value) noexcept
{
    if constexpr (std::is_same_v<T, bool>) {
        return static_cast<std::uint8_t>(value ? 1 : 0);
    } else if constexpr (std::is_enum_v<T>) {
        return BitsOf(static_cast<std::underlying_type_t<T>>(value));
    } else if constexpr (sizeof(T) == 1) {
        return std::bit_cast<std::uint8_t>(value);
    } else if constexpr (sizeof(T) == 2) {
        return std::bit_cast<std::uint16_t>(value);
    } else if constexpr (sizeof(T) == 4) {
        return std::bit_cast<std::uint32_t>(value);
    } else {
        static_assert(sizeof(T) == 8, "leaves are at most 8 bytes");
        return std::bit_cast<std::uint64_t>(value);
    }
}

template <typename T>
void WriteValue(const T& value, std::vector<std::byte>& out)
{
    if constexpr (IsLeaf<T>) {
        const auto bits = BitsOf(value);
        for (std::size_t i = 0; i < sizeof(bits); ++i) {
            out.push_back(static_cast<std::byte>((bits >> (8 * i)) & 0xFFu));
        }
    } else {
        static_assert(std::is_class_v<T>, "only arithmetic values, enums and classes serialise");
        constexpr auto members = MembersOf<T>();
        template for (constexpr std::size_t i : Indices<members.size()>)
        {
            constexpr std::meta::info member = members[i];
            WriteValue(value.[:member:], out);
        }
    }
}

/// Reads bytes in order; a failure is remembered and stops further reads.
struct ByteReader {
    std::span<const std::byte> Bytes;
    std::size_t Offset = 0;
    std::string Error;

    [[nodiscard]] bool Take(const std::size_t count, std::uint64_t& bits)
    {
        if (!Error.empty()) {
            return false;
        }
        if (Bytes.size() - Offset < count) {
            Error = TruncatedInputMessage(count, Offset, Bytes.size() - Offset);
            return false;
        }
        bits = 0;
        for (std::size_t i = 0; i < count; ++i) {
            bits |= std::uint64_t{std::to_integer<std::uint8_t>(Bytes[Offset + i])} << (8 * i);
        }
        Offset += count;
        return true;
    }
};

template <typename T>
void ReadLeaf(T& value, ByteReader& reader)
{
    using Bits = decltype(BitsOf(T{}));
    std::uint64_t bits = 0;
    if (!reader.Take(sizeof(Bits), bits)) {
        return;
    }
    if constexpr (std::is_same_v<T, bool>) {
        if (bits > 1) {
            reader.Error = InvalidBoolMessage(bits, reader.Offset - 1);
            return;
        }
        value = bits == 1;
    } else if constexpr (std::is_enum_v<T>) {
        using Underlying = std::underlying_type_t<T>;
        value = static_cast<T>(std::bit_cast<Underlying>(static_cast<Bits>(bits)));
    } else {
        value = std::bit_cast<T>(static_cast<Bits>(bits));
    }
}

template <typename T>
void ReadValue(T& value, ByteReader& reader)
{
    if constexpr (IsLeaf<T>) {
        ReadLeaf(value, reader);
    } else {
        constexpr auto members = MembersOf<T>();
        template for (constexpr std::size_t i : Indices<members.size()>)
        {
            constexpr std::meta::info member = members[i];
            ReadValue(value.[:member:], reader);
        }
    }
}

template <typename T>
void AppendJson(const T& value, std::string& out)
{
    if constexpr (std::is_same_v<T, bool>) {
        out += value ? "true" : "false";
    } else if constexpr (std::is_enum_v<T>) {
        AppendJson(static_cast<std::underlying_type_t<T>>(value), out);
    } else if constexpr (std::is_floating_point_v<T>) {
        AppendJsonDouble(static_cast<double>(value), out);
    } else if constexpr (std::is_integral_v<T> && std::is_signed_v<T>) {
        AppendJsonInteger(static_cast<long long>(value), out);
    } else if constexpr (std::is_integral_v<T>) {
        AppendJsonUnsigned(static_cast<unsigned long long>(value), out);
    } else {
        constexpr auto members = MembersOf<T>();
        out += '{';
        template for (constexpr std::size_t i : Indices<members.size()>)
        {
            constexpr std::meta::info member = members[i];
            if constexpr (i > 0) {
                out += ',';
            }
            out += '"';
            out += std::meta::identifier_of(member);
            out += "\":";
            AppendJson(value.[:member:], out);
        }
        out += '}';
    }
}

} // namespace Stereon::Detail
#endif

export namespace Stereon {

/// The binary form of value; empty without reflection.
template <typename T>
[[nodiscard]] std::vector<std::byte> Serialized([[maybe_unused]] const T& value)
{
    std::vector<std::byte> out;
#if STEREON_SERIALIZE_REFLECTION
    Detail::WriteValue(value, out);
#endif
    return out;
}

/// The value whose binary form bytes is; ParseError for malformed input,
/// NotSupported without reflection.
template <typename T>
    requires std::is_default_constructible_v<T>
[[nodiscard]] Result<T> Deserialized([[maybe_unused]] const std::span<const std::byte> bytes)
{
#if STEREON_SERIALIZE_REFLECTION
    T value{};
    Detail::ByteReader reader;
    reader.Bytes = bytes;
    Detail::ReadValue(value, reader);
    if (!reader.Error.empty()) {
        return Fail(ErrorCode::ParseError, std::move(reader.Error));
    }
    if (reader.Offset != bytes.size()) {
        return Fail(ErrorCode::ParseError,
                    Detail::LeftoverBytesMessage(bytes.size() - reader.Offset));
    }
    return value;
#else
    return Fail(ErrorCode::NotSupported, "serialisation needs static reflection (ADR-0016)");
#endif
}

/// A JSON view of value; empty without reflection.
template <typename T>
[[nodiscard]] std::string ToJson([[maybe_unused]] const T& value)
{
    std::string out;
#if STEREON_SERIALIZE_REFLECTION
    Detail::AppendJson(value, out);
#endif
    return out;
}

} // namespace Stereon
