module;

#include <cstddef>
#include <cstdint>
#include <optional>
#include <span>
#include <string>
#include <string_view>
#include <utility>
#include <vector>

export module Stereon.Topo:Operation;

import Stereon.Intersect;
import :Records;
import :Shape;

/// What a shape-producing operation returns (ADR-0006): the Shape, the
/// History of what became of the input's entities (ADR-0011, ADR-0030), the
/// tolerance changes it made (ADR-0001) and its structured warnings, all
/// published together and only once the result has been validated
/// (ADR-0026). Commit() and CompactShape() (Builder.cppm) return one.
///
/// The History relates the entities of an operation's inputs to those of
/// its result (ADR-0030): an entity of an input continues unchanged or
/// modified at an index of the result, or is deleted; an entity of the
/// result with no source was generated by the operation, its creation root,
/// or by named generators of the inputs (the two faces whose intersection
/// an edge is). A split is one source continued, Modified, by several
/// targets, and a merge several sources continued by one target; the
/// entries of one such event share a Group, so the event is explicit rather
/// than read off repeated indices. Entries carry the input's ordinal, the
/// kind and both indices, never an index alone, and are ordered by kind,
/// input, source, target, relation and group, so two runs give the same
/// History (ADR-0007). Commit() derives a one-input History by comparing
/// the builder's slots with the shape it was opened on; an operation of two
/// inputs records its own and publishes it through the Commit() that takes
/// one, which checks it is complete against every input.
///
/// None of these types is built with designated initializers in a module
/// implementation unit: GCC 16.2 has returned such values with their fields
/// scrambled to importing units (docs/toolchain/gcc16-feature-probe.md).

export namespace Stereon {

/// What became of an entity (ADR-0011, ADR-0030).
enum class HistoryRelation : std::uint8_t {
    /// The same entity, at the same or another index: nothing about it
    /// changed. A storage remap alone (Compact()) is Unchanged.
    Unchanged,
    /// The same entity, changed: its geometry, its tolerance, or what it
    /// bounds or is bounded by.
    Modified,
    /// New in the result, with no source in the input: the operation's
    /// creation root.
    Generated,
    /// Gone: no entity of the result continues it.
    Deleted,
};

[[nodiscard]] constexpr std::string_view ToString(const HistoryRelation relation) noexcept
{
    switch (relation) {
    case HistoryRelation::Unchanged:
        return "Unchanged";
    case HistoryRelation::Modified:
        return "Modified";
    case HistoryRelation::Generated:
        return "Generated";
    case HistoryRelation::Deleted:
        return "Deleted";
    }
    return "HistoryRelation";
}

/// The index an entry has when it has no entity on that side: no source for
/// a Generated entry without a generator, no target for a Deleted one.
inline constexpr std::uint32_t NoEntity = 0xFFFFFFFFu;

/// The Group of an entry that is no split or merge.
inline constexpr std::uint32_t NoGroup = 0xFFFFFFFFu;

/// One relation: an entity of input `Input` at index `Source` and the entity
/// of the result at index `Target` that continues it. A Generated entry's
/// Source, when it has one, names a generator of the target, of kind
/// SourceKind (a face whose intersection the target edge is); every other
/// entry's Source is of the entry's own Kind, and SourceKind is not read.
/// Entries of one split or merge event share a Group other than NoGroup.
struct HistoryEntry {
    EntityKind Kind = EntityKind::Vertex;
    HistoryRelation Relation = HistoryRelation::Unchanged;
    /// The ordinal of the input shape among the operation's inputs.
    std::uint8_t Input = 0;
    std::uint32_t Source = NoEntity;
    std::uint32_t Target = NoEntity;
    /// The split or merge event the entry belongs to, or NoGroup.
    std::uint32_t Group = NoGroup;
    /// The kind of a Generated entry's generator.
    EntityKind SourceKind = EntityKind::Vertex;

    constexpr bool operator==(const HistoryEntry&) const = default;
};

/// The relations of one operation, in the deterministic order above.
class History {
public:
    History() = default;
    /// Takes the entries and sorts them.
    explicit History(std::vector<HistoryEntry> entries);

    [[nodiscard]] std::span<const HistoryEntry> GetEntries() const& noexcept { return m_Entries; }

    std::span<const HistoryEntry> GetEntries() const&& = delete;

    /// The entries of one entity of an input: where it continues, or its
    /// deletion. Empty for an index that named no live entity of the input.
    /// A generator's entries are not among them: they are its target's.
    [[nodiscard]] std::vector<HistoryEntry> OfSource(EntityKind kind, std::uint32_t source,
                                                     std::uint8_t input = 0) const;
    /// The entries that lead to one entity of the result.
    [[nodiscard]] std::vector<HistoryEntry> OfTarget(EntityKind kind, std::uint32_t target) const;
    /// How many entries have the relation, over every kind or one.
    [[nodiscard]] std::size_t Count(HistoryRelation relation) const noexcept;
    [[nodiscard]] std::size_t Count(EntityKind kind, HistoryRelation relation) const noexcept;

private:
    std::vector<HistoryEntry> m_Entries;
};

/// One entity's tolerance as an operation changed it (ADR-0001: entity, old
/// value, new value, reason). Index is the entity's index in the result.
struct ToleranceChange {
    EntityKind Kind = EntityKind::Vertex;
    std::uint32_t Index = NoEntity;
    double Old = 0.0;
    double New = 0.0;
    std::string Reason;
};

/// The codes of an operation's structured warnings (ADR-0006).
enum class DiagnosticCode : std::uint32_t {
    /// A tolerance grew: the result is valid, at a looser tolerance.
    ToleranceGrown = 1,
    /// An edge's cached 3D curve was dropped because a pcurve, the primary
    /// coedge or a surface of the edge changed; rebuild it to use it.
    CacheDropped = 2,
};

[[nodiscard]] constexpr std::string_view ToString(const DiagnosticCode code) noexcept
{
    switch (code) {
    case DiagnosticCode::ToleranceGrown:
        return "ToleranceGrown";
    case DiagnosticCode::CacheDropped:
        return "CacheDropped";
    }
    return "DiagnosticCode";
}

/// A structured warning: its code, a message, and the entities it is about,
/// named with Describe().
struct Diagnostic {
    DiagnosticCode Code = DiagnosticCode::ToleranceGrown;
    std::string Message;
    std::vector<std::string> Entities;
};

/// Low-level operator provenance within one builder transaction. Indices
/// may name intermediates later deleted; these are events, not HistoryEntry
/// references into the published shape. Failed candidates publish no events.
enum class TopologyEventKind : std::uint8_t { Created, Deleted, Modified, Split, Merged };
struct TopologyEvent {
    EntityKind Kind = EntityKind::Vertex;
    TopologyEventKind Event = TopologyEventKind::Created;
    std::uint32_t Source = NoEntity;
    std::uint32_t Target = NoEntity;
    constexpr bool operator==(const TopologyEvent&) const = default;
};

/// The published result of a shape-producing operation (ADR-0006).
class OperationResult {
public:
    Stereon::Shape Shape;
    Stereon::History History;
    std::vector<ToleranceChange> ToleranceChanges;
    std::vector<Diagnostic> Warnings;
    std::vector<TopologyEvent> TopologyEvents;
    /// The highest validity level the result was checked at before it was
    /// published. Structural for now: the Geometric and Solid checks of
    /// ADR-0018 do not exist yet, whatever the Context asks for.
    ValidityLevel Checked = ValidityLevel::Structural;
};

} // namespace Stereon

export namespace Stereon::Detail {

/// The History from `source`, the tables an edit started from (null for a
/// new builder), to `result`, the same slots after the edit (ADR-0004: an
/// edit keeps every index). A slot live in both continues: Unchanged when
/// the entity and what it bounds are as they were, Modified otherwise; live
/// only in the source, Deleted; live only in the result, Generated.
[[nodiscard]] History HistoryBetween(const TopologyTables* source, const TopologyTables& result);

/// True when the History accounts for every live entity of both sides and
/// names only live ones (ADR-0030, Verification): checked before an
/// operation publishes.
[[nodiscard]] bool HistoryIsComplete(const History& history, const TopologyTables* source,
                                     const TopologyTables& result);

/// Why a History of several inputs is incomplete or malformed, or nothing
/// when it is sound (ADR-0030, Verification): every live entity of the
/// result has provenance and every live entity of every input a
/// disposition; every entry names live entities, of an input that exists;
/// a generator names a live entity of its kind; and every Group is one
/// split (one source, several Modified targets) or one merge (several
/// sources, one Modified target).
[[nodiscard]] std::optional<std::string>
HistoryProblem(const History& history, std::span<const TopologyTables* const> inputs,
               const TopologyTables& result);

} // namespace Stereon::Detail
