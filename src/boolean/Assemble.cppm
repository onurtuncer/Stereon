module;

#include <cstdint>
#include <string_view>

export module Stereon.Boolean:Assemble;

import :Classify;

/// Assembly (the Boolean prototype's M8, pipeline step 6): union, cut and
/// common of two solids. The bodies are imprinted (:Bodies) and their
/// regions classified (:Classify); the regions the operation keeps are
/// copied into a new shape, A's before B's: for a union each body's regions
/// outside the other, for a common those inside it, and for a cut A's
/// regions outside B with B's regions inside A turned inside out. A piece of
/// the intersection, an edge in each body, becomes one edge used by both
/// bodies' faces, the edge of A where a kept face of A uses it; its end
/// vertices are identified within the pair tolerance, the larger of the
/// two, A's position kept and the tolerance grown and logged where B's was
/// larger (ADR-0001's representative policy). What no kept face uses is not
/// copied, so the result is regularised: a contact of lower dimension leaves
/// nothing behind. The faces fall into shells by the edges they share; a
/// shell made only of B's reversed faces is a void of the solid around it,
/// and every other shell bounds a solid of its own.
///
/// The result is published with a History of both inputs (ADR-0030): every
/// entity of the result is traced through the imprint, its History and its
/// split events, to the entities of the operands it continues; an entity
/// several continue is a merge, several entities continuing one a split; an
/// intersection edge is Generated by the faces of each operand that met;
/// and every entity of the operands no kept one continues is Deleted.

export namespace Stereon {

/// Which Boolean.
enum class BooleanOperation : std::uint8_t {
    /// Everything in either solid.
    Union,
    /// The first solid without the second.
    Cut,
    /// What the solids have in common.
    Common,
};

[[nodiscard]] constexpr std::string_view ToString(const BooleanOperation operation) noexcept
{
    switch (operation) {
    case BooleanOperation::Union:
        return "Union";
    case BooleanOperation::Cut:
        return "Cut";
    case BooleanOperation::Common:
        return "Common";
    }
    return "BooleanOperation";
}

/// The regularised union, cut or common of the solids `a` and `b`, published
/// through Commit() with a History whose input 0 is `a` and input 1 `b`. An
/// empty result, two solids apart in a common, is a success with an empty
/// shape. What the imprint and the classification report otherwise
/// (NotSupported for coincident faces until they are handled, Unresolved
/// for a region nothing settles); IntersectionFailed when an intersection
/// edge's ends are not within the pair tolerance of each other in the two
/// bodies; NotSupported for a void when the kept regions form several
/// solids, which the prototype does not place.
[[nodiscard]] Result<OperationResult> Boolean(const Shape& a, const Shape& b,
                                              BooleanOperation operation, const Context& ctx);

} // namespace Stereon
